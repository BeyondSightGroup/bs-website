---
import RevealOnScroll from "../primitives/RevealOnScroll.astro";
import MockupFrame from "../primitives/MockupFrame.astro";
import GradientGlow from "../primitives/GradientGlow.astro";

const sidebar = [
  { label: "Dashboard", active: true },
  { label: "Monitoring", active: false },
  { label: "Management", active: false },
  { label: "Audit", active: false },
  { label: "Tools", active: false },
];

const metrics = [
  { label: "Active peers", value: "142", delta: "+12", color: "accent" },
  { label: "Tor circuits", value: "38", delta: "+3", color: "accent-2" },
  { label: "Bucket health", value: "98.7%", delta: "+0.4%", color: "accent" },
];
---

<section
  id="console"
  class="relative isolate overflow-hidden border-y border-border/40 bg-panel-2/40 py-24 sm:py-32"
>
  <GradientGlow color="accent" size="lg" position="top-0 left-1/4 -translate-y-1/3" />
  <GradientGlow color="accent-2" size="md" position="bottom-0 right-1/4 translate-y-1/3" />

  <div class="relative mx-auto max-w-7xl px-6">
    <RevealOnScroll class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent-2">
        Console
      </p>
      <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        Operate the network.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        A unified admin surface for every node, peer, and bucket. Watch Gun.js,
        Tor and MinIO health in real time, manage roles and audit every action.
      </p>
    </RevealOnScroll>

    <RevealOnScroll delay={100} class="mt-14">
      <MockupFrame
        variant="desktop"
        title="nimbus / console — dashboard"
        class="mx-auto max-w-5xl"
      >
        <div class="grid grid-cols-[180px_1fr] bg-panel">
          <aside class="border-r border-border bg-panel-2/60 p-3 text-xs">
            <div class="mb-3 flex items-center gap-2 px-2 py-1.5">
              <span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent/15 text-[11px] font-semibold text-accent ring-1 ring-inset ring-accent/30">
                N
              </span>
              <span class="font-semibold tracking-tight text-text">Console</span>
            </div>
            <ul class="space-y-0.5">
              {
                sidebar.map((item) => (
                  <li>
                    <a
                      class={
                        item.active
                          ? "flex items-center gap-2 rounded-md bg-accent/10 px-2 py-1.5 text-text ring-1 ring-inset ring-accent/20"
                          : "flex items-center gap-2 rounded-md px-2 py-1.5 text-muted hover:bg-panel hover:text-text"
                      }
                    >
                      <span class="h-1.5 w-1.5 rounded-full bg-current opacity-50" />
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mt-6 border-t border-border pt-3">
              <p class="px-2 text-[10px] uppercase tracking-widest text-muted">
                Workspace
              </p>
              <p class="mt-1 px-2 font-mono text-[11px] text-text">prod-nimbus</p>
            </div>
          </aside>

          <div class="flex flex-col">
            <div class="flex items-center gap-3 border-b border-border px-5 py-3">
              <p class="text-sm font-medium text-text">Dashboard</p>
              <span class="rounded-full bg-accent-2/15 px-2 py-0.5 text-[10px] font-medium text-accent-2 ring-1 ring-inset ring-accent-2/30">
                Live
              </span>
              <span class="ml-auto rounded border border-border bg-bg px-1.5 py-0.5 font-mono text-[10px] text-muted">
                ⌘K
              </span>
            </div>

            <div class="grid grid-cols-3 gap-3 p-5">
              {
                metrics.map((m) => (
                  <div class="rounded-lg border border-border bg-panel-2/60 p-3">
                    <p class="text-[10px] uppercase tracking-widest text-muted">
                      {m.label}
                    </p>
                    <p class="mt-1.5 flex items-baseline gap-2">
                      <span class="text-lg font-semibold tracking-tight text-text">
                        {m.value}
                      </span>
                      <span
                        class={
                          m.color === "accent"
                            ? "text-[10px] font-medium text-accent"
                            : "text-[10px] font-medium text-accent-2"
                        }
                      >
                        {m.delta}
                      </span>
                    </p>
                  </div>
                ))
              }
            </div>

            <div class="px-5 pb-5">
              <div class="rounded-lg border border-border bg-panel-2/60 p-4">
                <div class="flex items-center justify-between">
                  <p class="text-xs font-medium text-muted">
                    Throughput · last 24h
                  </p>
                  <p class="font-mono text-[11px] text-text">1,284 req/s</p>
                </div>
                <svg viewBox="0 0 320 50" class="mt-2 h-12 w-full" fill="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="cmFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#59c2ff" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="#59c2ff" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M0 38 L20 32 L40 35 L60 25 L80 28 L100 18 L120 22 L140 14 L160 19 L180 9 L200 14 L220 6 L240 12 L260 5 L280 8 L300 4 L320 2"
                    stroke="#59c2ff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M0 38 L20 32 L40 35 L60 25 L80 28 L100 18 L120 22 L140 14 L160 19 L180 9 L200 14 L220 6 L240 12 L260 5 L280 8 L300 4 L320 2 L320 50 L0 50 Z"
                    fill="url(#cmFill)"
                  />
                </svg>
              </div>
            </div>

            <div class="mt-auto flex items-center gap-3 border-t border-border bg-panel-2/80 px-4 py-2 text-[11px]">
              <span class="rounded bg-accent/15 px-1.5 py-0.5 font-mono font-semibold text-accent">
                PROD
              </span>
              <span class="font-mono text-muted">v0.1.0</span>
              <span class="ml-auto flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-accent-2" />
                <span class="text-text">Online</span>
              </span>
              <span class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                <span class="text-muted">WS connected</span>
              </span>
            </div>
          </div>
        </div>
      </MockupFrame>
    </RevealOnScroll>

    <RevealOnScroll delay={200} class="mx-auto mt-8 max-w-5xl">
      <p class="mb-3 text-center text-xs uppercase tracking-[0.18em] text-muted">
        StatusBar component · live capture
      </p>
      <div
        class="overflow-hidden rounded-xl border border-border bg-white"
        title="The actual StatusBar component running in the Nimbus Console"
      >
        <img
          src="/images/nimbus/console/statusbar-component.png"
          alt="Close-up of the live StatusBar component from the Nimbus Console"
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    </RevealOnScroll>
  </div>
</section>
