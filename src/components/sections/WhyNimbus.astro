---
import RevealOnScroll from "../primitives/RevealOnScroll.astro";

const features = [
  {
    title: "Decentralized",
    body: "No central server. Nimbus runs on a peer-to-peer mesh built on Gun.js, so there's no single point of failure to compromise or seize.",
    icon: "network",
  },
  {
    title: "Anonymous",
    body: "Traffic is routed over Tor hidden services. Your identity stays unlinked from the data you read, write, and share.",
    icon: "shield",
  },
  {
    title: "Encrypted end-to-end",
    body: "Files are encrypted on your device before they ever leave it. MinIO stores ciphertext only — keys never touch the network.",
    icon: "lock",
  },
  {
    title: "Offline-first",
    body: "Encrypted local caches in IndexedDB and OPFS keep you working when the network drops. Edits sync the moment you're back.",
    icon: "cloud-off",
  },
];

const iconPaths: Record<string, string> = {
  network:
    "M12 3a3 3 0 100 6 3 3 0 000-6zm0 12a3 3 0 100 6 3 3 0 000-6zM6 9a3 3 0 100 6 3 3 0 000-6zm12 0a3 3 0 100 6 3 3 0 000-6zM9 6.5l-1.5 2m9-2l1.5 2m-9 8.5l-1.5-2m9 2l1.5-2",
  shield:
    "M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z",
  lock: "M7 11V8a5 5 0 0110 0v3m-9 0h8a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2v-6a2 2 0 012-2z",
  "cloud-off":
    "M3 3l18 18M19 18.5A4.5 4.5 0 0017 10c0-3-2.5-5-5.5-5a5.5 5.5 0 00-5 3.2M6 10a4 4 0 00-3 6.7",
};
---

<section
  id="why"
  class="relative mx-auto max-w-7xl scroll-mt-20 px-6 py-24 sm:py-32"
>
  <RevealOnScroll class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">
      Why Nimbus
    </p>
    <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
      Built for teams who can't afford to be tracked.
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">
      Four guarantees, baked into every layer of the stack.
    </p>
  </RevealOnScroll>

  <div class="mt-14 grid gap-5 sm:grid-cols-2">
    {
      features.map((f, i) => (
        <RevealOnScroll delay={i * 90} class="h-full">
          <article class="panel-card group h-full p-6 transition hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10 text-accent ring-1 ring-inset ring-accent/30">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={iconPaths[f.icon]} />
                </svg>
              </span>
              <h3 class="text-lg font-semibold tracking-tight">{f.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{f.body}</p>
          </article>
        </RevealOnScroll>
      ))
    }
  </div>
</section>
