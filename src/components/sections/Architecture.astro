---
import RevealOnScroll from "../primitives/RevealOnScroll.astro";
import GradientGlow from "../primitives/GradientGlow.astro";

const nodes = [
  { id: "n1", x: 110, y: 100, label: "Peer" },
  { id: "n2", x: 320, y: 60, label: "Peer" },
  { id: "n3", x: 530, y: 110, label: "Peer" },
  { id: "n4", x: 200, y: 230, label: "Tor" },
  { id: "n5", x: 440, y: 240, label: "Tor" },
  { id: "n6", x: 320, y: 340, label: "MinIO" },
  { id: "n7", x: 320, y: 180, label: "Gun.js" },
];

const links: Array<[string, string]> = [
  ["n1", "n7"],
  ["n2", "n7"],
  ["n3", "n7"],
  ["n7", "n4"],
  ["n7", "n5"],
  ["n4", "n6"],
  ["n5", "n6"],
  ["n1", "n4"],
  ["n3", "n5"],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
---

<section
  id="architecture"
  class="relative isolate scroll-mt-20 overflow-hidden border-y border-border/40 bg-panel-2/40 py-24 sm:py-32"
>
  <GradientGlow color="accent" size="lg" position="top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" />

  <div class="relative mx-auto max-w-7xl px-6">
    <RevealOnScroll class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent-2">
        Architecture
      </p>
      <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        A mesh, not a stack.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Gun.js peers exchange CRDT updates over Tor circuits. MinIO holds
        encrypted blobs. There's no privileged node — and no kill switch.
      </p>
    </RevealOnScroll>

    <RevealOnScroll delay={120} class="mt-12">
      <div class="panel-card relative mx-auto max-w-4xl overflow-hidden p-4 sm:p-6">
        <svg
          viewBox="0 0 640 420"
          class="block h-auto w-full"
          data-graph-root
          aria-label="Diagram of Nimbus peers connected via Gun.js, Tor and MinIO"
        >
          <g data-graph-links stroke="#59c2ff" stroke-width="1.5" fill="none" opacity="0.6">
            {
              links.map(([a, b], i) => {
                const A = byId[a];
                const B = byId[b];
                return (
                  <path
                    d={`M ${A.x} ${A.y} L ${B.x} ${B.y}`}
                    data-graph-link
                    data-from={a}
                    data-to={b}
                    data-link-index={i}
                  />
                );
              })
            }
          </g>

          <g data-graph-packets fill="#6ee7b7">
            {
              links.map((_, i) => (
                <circle r="3" data-packet data-link-index={i} opacity="0" />
              ))
            }
          </g>

          <g data-graph-nodes>
            {
              nodes.map((n) => (
                <g data-graph-node transform={`translate(${n.x} ${n.y})`}>
                  <circle r="22" fill="#0d1420" stroke="#1f2a3a" stroke-width="1.5" />
                  <circle r="6" fill={n.label === "MinIO" ? "#f59e0b" : n.label === "Tor" ? "#6ee7b7" : "#59c2ff"} />
                  <text
                    y="38"
                    text-anchor="middle"
                    fill="#9fb0c0"
                    font-size="11"
                    font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
                  >
                    {n.label}
                  </text>
                </g>
              ))
            }
          </g>
        </svg>

        <ul class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-muted">
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-accent"></span>Gun.js peer
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-accent-2"></span>Tor relay
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-warn"></span>MinIO bucket
          </li>
        </ul>
      </div>
    </RevealOnScroll>
  </div>
</section>

<script>
  import { loadAnime, prefersReducedMotion } from "../../lib/anime";

  const svg = document.querySelector<SVGSVGElement>("[data-graph-root]");
  if (svg) {
    const links = Array.from(svg.querySelectorAll<SVGPathElement>("[data-graph-link]"));
    const nodes = svg.querySelectorAll<SVGGElement>("[data-graph-node]");
    const packets = Array.from(svg.querySelectorAll<SVGCircleElement>("[data-packet]"));

    // Pre-compute total length and seed dasharray so links are hidden until animated.
    const lengths = links.map((p) => {
      const len = p.getTotalLength();
      p.style.strokeDasharray = `${len}`;
      p.style.strokeDashoffset = `${len}`;
      return len;
    });

    if (prefersReducedMotion()) {
      links.forEach((p) => (p.style.strokeDashoffset = "0"));
    } else {
      const io = new IntersectionObserver(
        async (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.disconnect();
            const anime = await loadAnime();

            anime({
              targets: nodes,
              scale: [0, 1],
              opacity: [0, 1],
              easing: "easeOutBack",
              duration: 600,
              delay: anime.stagger(60),
              transformOrigin: "center",
            });

            anime({
              targets: links,
              strokeDashoffset: 0,
              easing: "easeInOutSine",
              duration: 900,
              delay: anime.stagger(40, { start: 200 }),
            });

            // Packets travel along each link, looping.
            packets.forEach((packet, i) => {
              const path = links[i];
              if (!path) return;
              const len = lengths[i];
              const obj = { t: 0 };
              packet.style.opacity = "1";
              anime({
                targets: obj,
                t: 1,
                easing: "linear",
                duration: 2400 + (i % 3) * 600,
                loop: true,
                delay: 800 + i * 220,
                update: () => {
                  const pt = path.getPointAtLength(obj.t * len);
                  packet.setAttribute("cx", String(pt.x));
                  packet.setAttribute("cy", String(pt.y));
                },
              });
            });
          }
        },
        { threshold: 0.3 }
      );
      io.observe(svg);
    }
  }
</script>
