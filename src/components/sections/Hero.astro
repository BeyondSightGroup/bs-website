---
import GradientGlow from "../primitives/GradientGlow.astro";
---

<section
  id="top"
  class="relative isolate overflow-hidden bg-radial-hero pb-24 pt-20 sm:pb-32 sm:pt-28"
>
  <GradientGlow color="accent" size="lg" position="top-0 right-0 -translate-y-20 translate-x-20" />
  <GradientGlow color="accent-2" size="md" position="bottom-0 left-0 translate-y-20 -translate-x-20" />

  <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-[1.15fr_1fr]">
    <div id="hero" class="text-center lg:text-left">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-panel/60 px-3 py-1 text-xs uppercase tracking-[0.18em] text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent-2"></span>
        Introducing Nimbus · v0.1 beta
      </p>
      <h1
        class="text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
      >
        A
        <span class="bg-gradient-to-br from-accent to-accent-2 bg-clip-text text-transparent">
          privacy-first network
        </span>
        for your data.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted lg:mx-0">
        Nimbus is a decentralized, secure application for managing and sharing
        data over a highly anonymous, privacy-focused network. No central
        servers. No tracked identities. Just your data, on your terms.
      </p>
      <div
        class="cta mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start"
      >
        <a
          href="#waitlist"
          class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-bg transition hover:brightness-110 glow-accent"
        >
          Join the waitlist
        </a>
        <a
          href="#why"
          class="inline-flex items-center justify-center gap-1.5 rounded-full border border-border bg-panel/60 px-6 py-3 text-sm font-medium text-text transition hover:border-accent/60 hover:text-accent"
        >
          See features <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="relative aspect-square">
        <div
          class="absolute inset-8 rounded-full bg-gradient-to-br from-accent/20 to-accent-2/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <img
          src="/images/nimbus/logo.png"
          alt="Nimbus logo"
          class="relative z-10 h-full w-full object-contain"
          id="hero-logo"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { loadAnime, prefersReducedMotion } from "../../lib/anime";

  async function run() {
    if (prefersReducedMotion()) return;
    const anime = await loadAnime();

    anime({
      targets: "#hero h1, #hero p, #hero .cta > *",
      translateY: [16, 0],
      opacity: [0, 1],
      easing: "easeOutCubic",
      duration: 700,
      delay: anime.stagger(90),
    });

    anime({
      targets: "#hero-logo",
      translateY: [0, -10],
      easing: "easeInOutSine",
      duration: 4000,
      direction: "alternate",
      loop: true,
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
</script>
