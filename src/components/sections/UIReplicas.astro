---
import RevealOnScroll from "../primitives/RevealOnScroll.astro";
import MockupFrame from "../primitives/MockupFrame.astro";
import CommandPaletteDemo from "../animations/CommandPaletteDemo.astro";
import StatusBarDemo from "../animations/StatusBarDemo.astro";
import SparklineDemo from "../animations/SparklineDemo.astro";

const items = [
  {
    eyebrow: "Command palette",
    title: "Every action, one keystroke away.",
    body: "Cmd+K opens role-aware commands across Console, Horizon and Orion. Searchable, discoverable, fast.",
    Demo: CommandPaletteDemo,
  },
  {
    eyebrow: "Live status",
    title: "Network health at a glance.",
    body: "Per-system indicators stream from the StatusBar component — same surface our team uses to operate the platform.",
    Demo: StatusBarDemo,
  },
  {
    eyebrow: "Metrics",
    title: "Trends drawn in real time.",
    body: "Throughput, peers, latency. Sparklines update as data flows so you spot regressions the moment they start.",
    Demo: SparklineDemo,
  },
];
---

<section
  id="replicas"
  class="relative mx-auto max-w-7xl scroll-mt-20 px-6 py-24 sm:py-32"
>
  <RevealOnScroll class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">
      Designed to disappear
    </p>
    <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
      The interface fades. Your work doesn't.
    </h2>
    <p class="mt-4 text-base leading-relaxed text-muted">
      Three primitives that show up across the suite — built to feel native on
      every surface.
    </p>
  </RevealOnScroll>

  <div class="mt-14 grid gap-6 lg:grid-cols-3">
    {
      items.map(({ eyebrow, title, body, Demo }, i) => (
        <RevealOnScroll delay={i * 90} class="h-full">
          <article class="panel-card flex h-full flex-col overflow-hidden">
            <MockupFrame variant="desktop" title={eyebrow.toLowerCase()} class="rounded-none border-0 border-b border-border shadow-none">
              <Demo />
            </MockupFrame>
            <div class="p-6">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">
                {eyebrow}
              </p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
            </div>
          </article>
        </RevealOnScroll>
      ))
    }
  </div>
</section>
