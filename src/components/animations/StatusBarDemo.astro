---
const indicators = [
  { label: "Gun.js", color: "accent-2" },
  { label: "Tor", color: "accent" },
  { label: "MinIO", color: "warn" },
];
---

<div
  class="flex h-72 flex-col justify-between rounded-xl bg-panel-2/80 p-5"
  data-statusbar-root
>
  <div>
    <p class="text-xs uppercase tracking-[0.18em] text-muted">Live status</p>
    <p class="mt-3 text-2xl font-semibold tracking-tight">All systems nominal</p>
  </div>

  <ul class="space-y-2.5">
    {
      indicators.map((i, idx) => (
        <li class="flex items-center gap-3 rounded-lg border border-border bg-panel/70 px-3 py-2">
          <span
            class={
              i.color === "accent-2"
                ? "h-2.5 w-2.5 rounded-full bg-accent-2"
                : i.color === "accent"
                ? "h-2.5 w-2.5 rounded-full bg-accent"
                : "h-2.5 w-2.5 rounded-full bg-warn"
            }
            data-statusbar-dot
            data-index={idx}
          />
          <span class="text-sm font-medium text-text">{i.label}</span>
          <span class="ml-auto font-mono text-xs text-muted" data-statusbar-num data-index={idx}>
            0.0
          </span>
          <span class="text-[10px] text-muted">MB/s</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { loadAnime, prefersReducedMotion } from "../../lib/anime";

  const root = document.querySelector<HTMLElement>("[data-statusbar-root]");
  if (root && !prefersReducedMotion()) {
    const io = new IntersectionObserver(
      async (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.disconnect();
          const anime = await loadAnime();

          const dots = root.querySelectorAll("[data-statusbar-dot]");
          anime({
            targets: dots,
            scale: [1, 1.35, 1],
            opacity: [1, 0.7, 1],
            easing: "easeInOutSine",
            duration: 1400,
            loop: true,
            delay: anime.stagger(280),
          });

          const nums = root.querySelectorAll<HTMLElement>("[data-statusbar-num]");
          const targets = [12.4, 8.1, 24.6];
          nums.forEach((el, idx) => {
            const obj = { v: 0 };
            anime({
              targets: obj,
              v: targets[idx],
              round: 10,
              easing: "easeInOutQuad",
              duration: 1800,
              direction: "alternate",
              loop: true,
              delay: idx * 200,
              update: () => {
                el.textContent = obj.v.toFixed(1);
              },
            });
          });
        }
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  }
</script>
