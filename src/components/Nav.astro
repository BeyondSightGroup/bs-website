---
const links = [
  { href: "#why", label: "Why Nimbus" },
  { href: "#apps", label: "Apps" },
  { href: "#architecture", label: "Architecture" },
  { href: "#waitlist", label: "Waitlist" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/70 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center gap-2 text-sm font-semibold tracking-tight">
      <span
        class="bg-gradient-to-br from-accent to-accent-2 bg-clip-text text-transparent"
        >Beyond Sight</span
      >
      <span class="font-light text-muted">Group</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm text-muted md:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="transition-colors hover:text-text focus-visible:text-text"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#waitlist"
      class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-2 text-sm font-medium text-accent ring-1 ring-inset ring-accent/30 transition hover:bg-accent/20"
    >
      Join waitlist
    </a>
  </nav>
</header>
